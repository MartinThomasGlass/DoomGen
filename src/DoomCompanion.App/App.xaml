<Application x:Class="DoomCompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DoomCompanion.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Paleta -->
        <Color x:Key="ColorFondo">#0F0F10</Color>
        <Color x:Key="ColorPanel">#1A1A1D</Color>
        <Color x:Key="ColorPanelAlto">#242428</Color>
        <Color x:Key="ColorBorde">#3A3A40</Color>
        <Color x:Key="ColorTexto">#ECECEC</Color>
        <Color x:Key="ColorTextoSuave">#A8A8B0</Color>
        <Color x:Key="ColorAcento">#C62828</Color>
        <Color x:Key="ColorAcentoClaro">#EF5350</Color>
        <Color x:Key="ColorExito">#43A047</Color>

        <SolidColorBrush x:Key="Fondo" Color="{StaticResource ColorFondo}" />
        <SolidColorBrush x:Key="Panel" Color="{StaticResource ColorPanel}" />
        <SolidColorBrush x:Key="PanelAlto" Color="{StaticResource ColorPanelAlto}" />
        <SolidColorBrush x:Key="Borde" Color="{StaticResource ColorBorde}" />
        <SolidColorBrush x:Key="Texto" Color="{StaticResource ColorTexto}" />
        <SolidColorBrush x:Key="TextoSuave" Color="{StaticResource ColorTextoSuave}" />
        <SolidColorBrush x:Key="Acento" Color="{StaticResource ColorAcento}" />
        <SolidColorBrush x:Key="AcentoClaro" Color="{StaticResource ColorAcentoClaro}" />
        <SolidColorBrush x:Key="Exito" Color="{StaticResource ColorExito}" />

        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />
        <local:BoolInvertidoAVisibilidad x:Key="BoolInvertidoAVisibilidad" />
        <local:NuloAVisibilidad x:Key="NuloAVisibilidad" />
        <local:TextoVacioAVisibilidad x:Key="TextoVacioAVisibilidad" />
        <local:CeroAVisibilidad x:Key="CeroAVisibilidad" />
        <local:TipoMensajeATexto x:Key="TipoMensajeATexto" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AcentoClaro}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Suave" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="Background" Value="{StaticResource PanelAlto}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AcentoClaro}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Acento}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Acento}" />
            <Setter Property="BorderBrush" Value="{StaticResource AcentoClaro}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="BotonChico" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Resources>
                <!-- El ComboBox del tema de Windows es claro: el texto tiene que ser oscuro. -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#202020" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Application.Resources>
</Application>
