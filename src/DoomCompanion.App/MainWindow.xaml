<Window x:Class="DoomCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DoomCompanion.App.ViewModels"
        xmlns:ctl="clr-namespace:DoomCompanion.App.Controles"
        Title="{Binding Titulo, StringFormat='{}{0} — Doom Companion'}"
        Icon="Recursos/icono.ico"
        Width="1600" Height="900" MinWidth="1100" MinHeight="650"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fondo}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding AumentarEscalaCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding AumentarEscalaCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ReducirEscalaCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding ReducirEscalaCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding GuardarPartidaCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding ImportarMapaCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Raiz">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Escala}" ScaleY="{Binding Escala}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Barra superior ============================== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Acento}" BorderThickness="0,0,0,2" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="A−" ToolTip="Achicar todo (Ctrl −)" Command="{Binding ReducirEscalaCommand}" Style="{StaticResource BotonChico}" />
                    <Button Content="A+" ToolTip="Agrandar todo (Ctrl +)" Command="{Binding AumentarEscalaCommand}" Style="{StaticResource BotonChico}" />
                    <Button x:Name="BotonPantallaCompleta" Content="⛶ Pantalla completa" ToolTip="F11" Click="AlternarPantallaCompleta" />
                    <Button Content="⋯ Más" Click="AbrirMenuMas">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuMas" FontSize="15">
                                <MenuItem Header="Exportar guía para IA…" Command="{Binding ExportarGuiaCommand}" />
                                <Separator />
                                <MenuItem Header="Editar catálogo de piezas…" Command="{Binding EditarCatalogoCommand}" />
                                <MenuItem Header="Recargar catálogo" Command="{Binding RecargarCatalogoCommand}" />
                                <MenuItem Header="Abrir carpeta de datos" Click="AbrirCarpetaDatos" />
                                <Separator />
                                <MenuItem Header="Cargar escenario de ejemplo" Command="{Binding CargarEjemploCommand}" />
                                <MenuItem Header="Ver resultado de la validación del mapa…" Command="{Binding VerValidacionCommand}" IsEnabled="{Binding HayPartida}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,16,0" MaxWidth="320">
                    <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Suave}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="📂 Importar mapa" Command="{Binding ImportarMapaCommand}" Style="{StaticResource BotonPrimario}" />
                    <Button Content="💾 Guardar" Command="{Binding GuardarPartidaCommand}" IsEnabled="{Binding HayPartida}" />
                    <Button Content="📥 Cargar" Command="{Binding CargarPartidaCommand}" />
                    <Button Content="↺ Reiniciar" Command="{Binding ReiniciarCommand}" IsEnabled="{Binding HayPartida}" />
                    <Rectangle Width="1" Height="28" Fill="{StaticResource Borde}" Margin="8,4" />
                    <Button Content="📜 Briefing" Command="{Binding VerBriefingCommand}" IsEnabled="{Binding HayPartida}" />
                    <Button Content="👁 Notas del invasor" Command="{Binding AlternarNotasInvasorCommand}" IsEnabled="{Binding HayPartida}" />
                    <Rectangle Width="1" Height="28" Fill="{StaticResource Borde}" Margin="8,4" />
                    <Button Content="🏆 Victoria" Command="{Binding DeclararVictoriaCommand}" IsEnabled="{Binding HayPartida}" />
                    <Button Content="💀 Derrota" Command="{Binding DeclararDerrotaCommand}" IsEnabled="{Binding HayPartida}" />
                </WrapPanel>

            </DockPanel>
        </Border>

        <!-- ============================== Zona de juego ============================== -->
        <Grid Grid.Row="1" Visibility="{Binding HayPartida, Converter={StaticResource BoolAVisibilidad}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Mapa -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="4">
                <Grid>
                    <ctl:MapaControl x:Name="Mapa" Motor="{Binding Motor}" Version="{Binding VersionMapa}" SeleccionId="{Binding SeleccionId}" />
                    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10" Padding="20,6" CornerRadius="6"
                            Background="#CC000000" Visibility="{Binding ResultadoTexto, Converter={StaticResource NuloAVisibilidad}}">
                        <TextBlock Text="{Binding ResultadoTexto}" FontSize="30" FontWeight="Black" Foreground="{StaticResource AcentoClaro}" />
                    </Border>
                    <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,6" Style="{StaticResource Suave}" FontSize="13"
                               Text="Clic en un área para verla · clic en una puerta para intentar abrirla" />
                </Grid>
            </Border>

            <!-- Panel del area seleccionada -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel DataContext="{Binding AreaSeleccionada}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{Binding EstadoColor}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EstadoTexto}" FontSize="13" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding Nombre}" Style="{StaticResource Titulo}" />
                        </DockPanel>

                        <!-- Area solo conocida -->
                        <TextBlock Visibility="{Binding EsConocida, Converter={StaticResource BoolAVisibilidad}}" Style="{StaticResource Suave}" Margin="0,10"
                                   Text="Saben que esta área existe, pero todavía no llegaron. Se revela al abrir una puerta que conduzca hasta ella." />

                        <StackPanel Visibility="{Binding EsConocida, Converter={StaticResource BoolInvertidoAVisibilidad}}">
                            <TextBlock Text="{Binding TextoEntrar}" Margin="0,10,0,4" FontStyle="Italic" />
                            <Button Content="🔊 Leer en grande" HorizontalAlignment="Left" Style="{StaticResource BotonChico}"
                                    Command="{Binding DataContext.ReleerEntradaCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                            <TextBlock Text="COLOCAR EN LA MESA" Style="{StaticResource Subtitulo}" />
                            <Border Background="{StaticResource PanelAlto}" CornerRadius="4" Padding="10,6">
                                <TextBlock Text="{Binding Preparacion}" FontFamily="Consolas" FontSize="14" />
                            </Border>

                            <TextBlock Text="MONSTRUOS" Style="{StaticResource Subtitulo}" />
                            <TextBlock Text="{Binding ResumenMonstruos}" Style="{StaticResource Suave}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Monstruos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MonstruoVM}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Quitar aparición" Style="{StaticResource BotonChico}"
                                                    Visibility="{Binding Agregado, Converter={StaticResource BoolAVisibilidad}}"
                                                    Command="{Binding DataContext.QuitarMonstruoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <CheckBox IsChecked="{Binding Muerto, Mode=OneWay}" Content="{Binding Etiqueta}"
                                                      Command="{Binding DataContext.AlternarMonstruoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" ToolTip="Marcar como eliminado" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,6,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button DockPanel.Dock="Right" Content="+ Agregar aparición" Command="{Binding AgregarMonstruoCommand}" Style="{StaticResource BotonChico}" />
                                <ComboBox ItemsSource="{Binding TiposMonstruo}" SelectedItem="{Binding MonstruoAAgregar}" />
                            </DockPanel>

                            <TextBlock Text="OBJETOS" Style="{StaticResource Subtitulo}" />
                            <TextBlock Text="No hay objetos en esta área." Style="{StaticResource Suave}"
                                       Visibility="{Binding Objetos.Count, Converter={StaticResource CeroAVisibilidad}}" />
                            <ItemsControl ItemsSource="{Binding Objetos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ObjetoVM}">
                                        <StackPanel Margin="0,0,0,4">
                                            <CheckBox IsChecked="{Binding Recogido, Mode=OneWay}" Content="{Binding Etiqueta}" ToolTip="Marcar como recogido (pasa al inventario)"
                                                      Command="{Binding DataContext.AlternarObjetoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Texto}" Style="{StaticResource Suave}" Margin="26,0,0,0"
                                                       Visibility="{Binding Texto, Converter={StaticResource TextoVacioAVisibilidad}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="PUERTAS" Style="{StaticResource Subtitulo}" />
                            <ItemsControl ItemsSource="{Binding Puertas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PuertaVM}">
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="{Binding Accion}" MinWidth="80"
                                                    Command="{Binding DataContext.AbrirPuertaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Border Width="18" Height="18" CornerRadius="3" Background="{Binding Color}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NombreTipo}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Destino, StringFormat='→ {0}'}" Style="{StaticResource Suave}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding EsDespejada, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Text="ÁREA DESPEJADA" Style="{StaticResource Subtitulo}" Foreground="{StaticResource Exito}" />
                                <TextBlock Text="{Binding TextoDespejar}" FontStyle="Italic" />
                                <TextBlock Text="RECOMPENSAS OBTENIDAS" Style="{StaticResource Subtitulo}" Foreground="{StaticResource Exito}" />
                                <ItemsControl ItemsSource="{Binding Recompensas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Margin="0,14,0,0" Padding="10" CornerRadius="4" Background="#33AB47BC" BorderBrush="#AB47BC" BorderThickness="1"
                                    Visibility="{Binding NotasInvasor, Converter={StaticResource TextoVacioAVisibilidad}}">
                                <StackPanel>
                                    <TextBlock Text="NOTAS DEL INVASOR" FontWeight="Bold" FontSize="13" Foreground="#CE93D8" />
                                    <TextBlock Text="{Binding NotasInvasor}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel lateral: inventario, eventos, historial -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="INVENTARIO DEL EQUIPO" Style="{StaticResource Subtitulo}" Margin="14,10,14,4" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="10,4,10,10">
                            <Button DockPanel.Dock="Right" Content="+" ToolTip="Agregar al inventario" Command="{Binding AgregarAlInventarioCommand}" Style="{StaticResource BotonChico}" MinWidth="34" />
                            <ComboBox ItemsSource="{Binding TiposObjeto}" SelectedItem="{Binding ObjetoAAgregar}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0">
                            <StackPanel>
                                <TextBlock Text="Vacío. Recogé objetos o despejá áreas." Style="{StaticResource Suave}"
                                           Visibility="{Binding Inventario.Count, Converter={StaticResource CeroAVisibilidad}}" />
                                <ItemsControl ItemsSource="{Binding Inventario}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GrupoInventarioVM}">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Nombre}" Style="{StaticResource Suave}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ItemInventarioVM}">
                                                            <DockPanel Margin="0,1">
                                                                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource BotonChico}" MinWidth="30"
                                                                        Command="{Binding DataContext.SumarInventarioCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                <Button DockPanel.Dock="Right" Content="−" Style="{StaticResource BotonChico}" MinWidth="30"
                                                                        Command="{Binding DataContext.RestarInventarioCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cantidad}" FontWeight="Bold" FontSize="19" Margin="8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="EVENTOS" Style="{StaticResource Subtitulo}" Margin="0,0,0,4" />
                        <TextBlock Text="Este escenario no tiene eventos manuales." Style="{StaticResource Suave}"
                                   Visibility="{Binding EventosManuales.Count, Converter={StaticResource CeroAVisibilidad}}" />
                        <ItemsControl ItemsSource="{Binding EventosManuales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EventoVM}">
                                    <CheckBox IsChecked="{Binding Activo, Mode=OneWay}" Content="{Binding Nombre}" ToolTip="{Binding Descripcion}"
                                              Command="{Binding DataContext.AlternarEventoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding EventosAutomaticos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='✔ {0}'}" Foreground="{StaticResource Exito}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="HISTORIAL" Style="{StaticResource Subtitulo}" Margin="14,10,14,4" />
                        <ListBox ItemsSource="{Binding Historial}" Background="Transparent" BorderThickness="0" Margin="6,0,6,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="HistorialDobleClic" x:Name="ListaHistorial"
                                 ToolTip="Doble clic para volver a leer">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="13" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================== Pantalla de inicio ============================== -->
        <Grid Grid.Row="1" Visibility="{Binding HayPartida, Converter={StaticResource BoolInvertidoAVisibilidad}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                <TextBlock Text="DOOM COMPANION" FontSize="64" FontWeight="Black" Foreground="{StaticResource Acento}" HorizontalAlignment="Center" FontFamily="Impact" />
                <TextBlock Text="Acompañante de partidas para Doom: The Boardgame" Style="{StaticResource Suave}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,30" />
                <Button Content="▶ Continuar la última partida" Command="{Binding ContinuarAutoguardadoCommand}" Style="{StaticResource BotonPrimario}"
                        FontSize="20" Padding="20,12" Visibility="{Binding HayAutoguardado, Converter={StaticResource BoolAVisibilidad}}" />
                <Button Content="📂 Importar mapa…" Command="{Binding ImportarMapaCommand}" FontSize="20" Padding="20,12" />
                <Button Content="📥 Cargar partida guardada…" Command="{Binding CargarPartidaCommand}" FontSize="20" Padding="20,12" />
                <Button Content="🧪 Jugar el escenario de ejemplo" Command="{Binding CargarEjemploCommand}" FontSize="20" Padding="20,12" />
                <Button Content="🤖 Exportar guía para IA…" Command="{Binding ExportarGuiaCommand}" FontSize="20" Padding="20,12" />
                <TextBlock Style="{StaticResource Suave}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,0"
                           Text="F11: pantalla completa · Ctrl + / Ctrl −: tamaño de letra · Enter: siguiente texto" />
            </StackPanel>
        </Grid>

        <!-- ============================== Barra de estado ============================== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12,4">
            <TextBlock Text="{Binding Estado}" Style="{StaticResource Suave}" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </Border>

        <!-- ============================== Lector de textos ============================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#D8000000" Visibility="{Binding LectorVisible, Converter={StaticResource BoolAVisibilidad}}"
              MouseLeftButtonDown="FondoLectorClic">
            <Border MaxWidth="1150" Margin="60" VerticalAlignment="Center" Background="{StaticResource Panel}" BorderBrush="{StaticResource Acento}"
                    BorderThickness="2" CornerRadius="8" Padding="40,30" DataContext="{Binding MensajeActual}" MouseLeftButtonDown="TarjetaLectorClic">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Tipo, Converter={StaticResource TipoMensajeATexto}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AcentoClaro}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" FontSize="38" FontWeight="Bold" Margin="0,4,0,16" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button DockPanel.Dock="Right" Content="{Binding IndiceLector}" Command="{Binding SiguienteMensajeCommand}"
                                Style="{StaticResource BotonPrimario}" FontSize="20" Padding="24,10" x:Name="BotonSiguiente" />
                        <Button DockPanel.Dock="Right" Content="Cerrar todo" Command="{Binding CerrarLectorCommand}" FontSize="16" />
                        <TextBlock Text="Enter / Espacio: siguiente · Esc: cerrar" Style="{StaticResource Suave}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                        <StackPanel>
                            <TextBlock Text="{Binding Texto}" FontSize="28" LineHeight="40" />
                            <Border Margin="0,20,0,0" Padding="14,10" Background="{StaticResource PanelAlto}" CornerRadius="4"
                                    Visibility="{Binding Detalle, Converter={StaticResource TextoVacioAVisibilidad}}">
                                <TextBlock Text="{Binding Detalle}" FontSize="20" FontFamily="Consolas" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
